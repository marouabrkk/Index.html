<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>La Boîte à Voix de Mima & Babi — Pour Khadija ❤️</title>

    <!-- Polices douces et enfantines élégantes -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Caveat:wght@600;700&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-color: #FAF6F0;
            --card-bg: #FFFFFF;
            --mima-color: #E88D98;     /* Rose poudré doux pour Mima */
            --mima-light: #FDF0F2;
            --babi-color: #79A3B1;     /* Bleu sauge doux pour Babi */
            --babi-light: #EEF5F7;
            --accent-warm: #D98A6C;    /* Terracotta doux */
            --text-dark: #3A3238;
            --text-muted: #82757E;
            --border-soft: #EFE7DE;
            --shadow: 0 10px 25px rgba(115, 95, 85, 0.08);
            --radius-main: 22px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-dark);
            line-height: 1.6;
            padding-bottom: 70px;
        }

        h1, h2, h3, .font-title {
            font-family: 'Quicksand', sans-serif;
            font-weight: 700;
        }

        .font-handwriting {
            font-family: 'Caveat', cursive;
        }

        .container {
            max-width: 700px;
            margin: 0 auto;
            padding: 0 18px;
        }

        /* EN-TÊTE / DÉDICACE À KHADIJA */
        .hero {
            background: linear-gradient(135deg, #FFEBE6 0%, #F5EFEB 50%, #E6F0F5 100%);
            border-bottom: 2px dashed var(--border-soft);
            padding: 40px 20px 30px;
            text-align: center;
            border-radius: 0 0 35px 35px;
            margin-bottom: 30px;
            box-shadow: var(--shadow);
        }

        .hero-badge {
            display: inline-block;
            background: #FFFFFF;
            color: var(--accent-warm);
            padding: 6px 18px;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .hero-title {
            font-size: 2.2rem;
            color: var(--text-dark);
            margin-bottom: 8px;
        }

        .hero-dedication {
            font-size: 1.25rem;
            color: var(--accent-warm);
            font-weight: 700;
        }

        /* LES ENFANTS BADGES */
        .kids-summary {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 18px;
            flex-wrap: wrap;
        }

        .kid-chip {
            background: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            box-shadow: 0 4px 10px rgba(0,0,0,0.04);
        }

        .kid-chip.mima { border-left: 4px solid var(--mima-color); }
        .kid-chip.babi { border-left: 4px solid var(--babi-color); }

        /* CARTE FORMULAIRE D'ENREGISTREMENT */
        .card {
            background: var(--card-bg);
            border-radius: var(--radius-main);
            padding: 28px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border-soft);
            margin-bottom: 35px;
        }

        .card-header {
            text-align: center;
            margin-bottom: 22px;
        }

        .card-title {
            font-size: 1.5rem;
            color: var(--text-dark);
        }

        /* Choix de l'enfant */
        .child-selector {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 20px;
        }

        .child-option {
            border: 2px solid var(--border-soft);
            border-radius: 16px;
            padding: 12px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

        .child-option input { display: none; }

        .child-option.selected-mima {
            border-color: var(--mima-color);
            background-color: var(--mima-light);
            color: var(--mima-color);
            font-weight: 700;
        }

        .child-option.selected-babi {
            border-color: var(--babi-color);
            background-color: var(--babi-light);
            color: var(--babi-color);
            font-weight: 700;
        }

        .form-group {
            margin-bottom: 18px;
        }

        label {
            display: block;
            font-size: 0.9rem;
            font-weight: 700;
            margin-bottom: 6px;
            color: var(--text-dark);
        }

        input[type="text"], input[type="date"], select, textarea {
            width: 100%;
            padding: 12px 16px;
            border-radius: 14px;
            border: 1px solid var(--border-soft);
            font-family: 'Nunito', sans-serif;
            font-size: 0.95rem;
            background: #FCFAF8;
            color: var(--text-dark);
            transition: 0.3s;
        }

        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--accent-warm);
            background: white;
            box-shadow: 0 0 0 3px rgba(217, 138, 108, 0.15);
        }

        /* Section Dictio rigolo optionnelle */
        .funny-word-box {
            background: #FFFDF9;
            border: 1px dashed #E0C0A8;
            border-radius: 14px;
            padding: 14px;
            margin-bottom: 18px;
        }

        /* Enregistreur audio */
        .voice-recorder-area {
            background: linear-gradient(135deg, #FFF9F7 0%, #FAF5F2 100%);
            border: 2px dashed var(--accent-warm);
            border-radius: 18px;
            padding: 22px;
            text-align: center;
            margin-bottom: 20px;
        }

        .btn-record {
            background: var(--accent-warm);
            color: white;
            border: none;
            padding: 14px 28px;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 700;
            font-family: 'Quicksand', sans-serif;
            cursor: pointer;
            box-shadow: 0 6px 18px rgba(217, 138, 108, 0.35);
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: 0.3s;
        }

        .btn-record.recording {
            background: #E74C3C;
            animation: pulse 1.4s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.06); }
            100% { transform: scale(1); }
        }

        #audioPreview {
            width: 100%;
            height: 40px;
            margin-top: 15px;
            display: none;
        }

        .btn-submit {
            width: 100%;
            background: var(--text-dark);
            color: white;
            border: none;
            padding: 15px;
            border-radius: 50px;
            font-size: 1.05rem;
            font-weight: 700;
            font-family: 'Quicksand', sans-serif;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(58, 50, 56, 0.25);
            transition: 0.3s;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            background: #251E23;
        }

        /* FILTRES D'AFFICHAGE */
        .filter-nav {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 15px;
            margin-bottom: 20px;
            scrollbar-width: none;
        }

        .filter-btn {
            background: white;
            border: 1px solid var(--border-soft);
            padding: 8px 18px;
            border-radius: 30px;
            font-size: 0.88rem;
            font-weight: 700;
            font-family: 'Quicksand', sans-serif;
            cursor: pointer;
            white-space: nowrap;
            color: var(--text-muted);
            transition: 0.2s;
        }

        .filter-btn.active {
            background: var(--text-dark);
            color: white;
            border-color: var(--text-dark);
        }

        /* LISTE DES SOUVENIRS */
        .memory-card {
            background: var(--card-bg);
            border-radius: var(--radius-main);
            padding: 22px;
            margin-bottom: 20px;
            border: 1px solid var(--border-soft);
            box-shadow: var(--shadow);
            position: relative;
            animation: fadeIn 0.4s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .memory-card.mima-card { border-left: 6px solid var(--mima-color); }
        .memory-card.babi-card { border-left: 6px solid var(--babi-color); }
        .memory-card.capsule-card { border-left: 6px solid #F39C12; }

        .memory-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .child-tag {
            font-size: 0.85rem;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 20px;
        }

        .tag-mima { background: var(--mima-light); color: var(--mima-color); }
        .tag-babi { background: var(--babi-light); color: var(--babi-color); }
        .tag-capsule { background: #FEF5E7; color: #F39C12; }

        .calculated-age {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-weight: 600;
        }

        .memory-title {
            font-size: 1.25rem;
            color: var(--text-dark);
            margin-bottom: 6px;
        }

        .memory-desc {
            font-size: 0.95rem;
            color: #5C5259;
            margin-bottom: 14px;
        }

        .funny-quote {
            background: #FFF8EE;
            border-radius: 12px;
            padding: 10px 14px;
            font-size: 0.95rem;
            margin-bottom: 12px;
            color: #B25E00;
        }

        .memory-photo {
            width: 100%;
            max-height: 300px;
            object-fit: cover;
            border-radius: 14px;
            margin-bottom: 12px;
        }

        .memory-audio {
            width: 100%;
            height: 40px;
            margin-top: 5px;
        }

        .btn-delete {
            position: absolute;
            top: 15px;
            right: 15px;
            background: none;
            border: none;
            color: #D3C5C7;
            cursor: pointer;
            font-size: 1rem;
            transition: 0.2s;
        }

        .btn-delete:hover { color: #E74C3C; }
    </style>
</head>
<body>

    <!-- EN-TÊTE DU CADEAU POUR KHADIJA -->
    <header class="hero">
        <div class="container">
            <div class="hero-badge">🎁 Le Coffre aux Merveilles de Khadija</div>
            <h1 class="hero-title">Les Petites Voix d'Amour</h1>
            <p class="hero-dedication font-handwriting">Pour ma sœur chérie Khadija, pour ne jamais oublier la douceur de leurs premiers rires et de leurs mots d'enfants ❤️</p>
            
            <div class="kids-summary">
                <div class="kid-chip mima">
                    <span>👧 <strong>Mima</strong></span>
                    <small style="color: #777;">(Née le 28 mai 2023)</small>
                </div>
                <div class="kid-chip babi">
                    <span>👶 <strong>Babi</strong></span>
                    <small style="color: #777;">(Né le 22 oct. 2025)</small>
                </div>
            </div>
        </div>
    </header>

    <main class="container">
        <!-- FORMULAIRE D'ENREGISTREMENT -->
        <section class="card">
            <div class="card-header">
                <h2 class="card-title">✨ Ajouter un Souvenir Sonore</h2>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Enregistre la voix de Mima ou Babi en quelques secondes</p>
            </div>

            <form id="memoryForm">
                <!-- Choix de l'enfant -->
                <label>QUI PARLE ?</label>
                <div class="child-selector">
                    <label class="child-option selected-mima" id="optMima" onclick="selectChild('Mima')">
                        <input type="radio" name="child" value="Mima" checked>
                        <span style="font-size: 1.3rem;">👧</span>
                        <span>Mima</span>
                    </label>
                    <label class="child-option" id="optBabi" onclick="selectChild('Babi')">
                        <input type="radio" name="child" value="Babi">
                        <span style="font-size: 1.3rem;">👶</span>
                        <span>Babi</span>
                    </label>
                </div>

                <div class="form-group">
                    <label for="memoryTitle">TITRE DU SOUVENIR</label>
                    <input type="text" id="memoryTitle" placeholder="Ex: Premier fou rire, Elle chante une chanson..." required>
                </div>

                <div class="form-group">
                    <label for="memoryCategory">CATÉGORIE DU SOUVENIR</label>
                    <select id="memoryCategory" onchange="checkCategory()">
                        <option value="rire">🍼 Premiers rires & Babillages</option>
                        <option value="mot">🗣️ Mot Rigolo / Dictionnaire d'enfant</option>
                        <option value="chanson">🎶 Petite chanson / Comptine</option>
                        <option value="histoire">📖 Histoire racontée</option>
                        <option value="capsule">⏳ Capsule Secrète pour leurs 18 ans</option>
                    </select>
                </div>

                <!-- Zone spéciale si c'est un mot rigolo -->
                <div class="funny-word-box" id="funnyWordBox" style="display: none;">
                    <label style="color: #B25E00;">LE MOT D'ENFANT & SA SIGNIFICATION :</label>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 5px;">
                        <input type="text" id="kidWord" placeholder="Ex: Tut-tut">
                        <input type="text" id="realMeaning" placeholder="Ex: Voiture">
                    </div>
                </div>

                <div class="form-group">
                    <label for="memoryDate">DATE DU SOUVENIR (L'âge est calculé automatiquement)</label>
                    <input type="date" id="memoryDate" required>
                </div>

                <div class="form-group">
                    <label for="memoryNotes">PETIT MOT / ANECDOTE (Optionnel)</label>
                    <textarea id="memoryNotes" rows="2" placeholder="Que s'est-il passé ce jour-là ?"></textarea>
                </div>

                <!-- ENREGISTREUR AUDIO -->
                <div class="voice-recorder-area">
                    <button type="button" class="btn-record" id="recordBtn">
                        <i class="fa-solid fa-microphone"></i> <span id="recordBtnText">Enregistrer la voix</span>
                    </button>
                    <div id="recordTimer" style="font-weight: 700; color: #E74C3C; margin-top: 8px; display: none;">00:00</div>
                    <audio id="audioPreview" controls></audio>
                </div>

                <!-- AJOUTER UNE PHOTO -->
                <div class="form-group" style="text-align: center;">
                    <button type="button" onclick="document.getElementById('photoInput').click()" style="background: white; border: 1px solid var(--border-soft); padding: 10px 20px; border-radius: 30px; font-weight: 600; cursor: pointer; color: var(--text-dark);">
                        <i class="fa-solid fa-camera-retro" style="color: var(--accent-warm); margin-right: 6px;"></i> Ajouter une photo souvenir
                    </button>
                    <input type="file" id="photoInput" accept="image/*" style="display: none;">
                    <div id="photoPreviewContainer" style="display: none; margin-top: 10px;">
                        <img id="photoPreview" src="" style="max-height: 150px; border-radius: 12px; border: 1px solid var(--border-soft);">
                    </div>
                </div>

                <button type="submit" class="btn-submit">
                    💾 Sauvegarder ce trésor
                </button>
            </form>
        </section>

        <!-- FILTRES PAR ENFANT -->
        <div class="filter-nav">
            <button class="filter-btn active" onclick="filterMemories('all', this)">🌸 Tous les souvenirs</button>
            <button class="filter-btn" onclick="filterMemories('Mima', this)">👧 Mima</button>
            <button class="filter-btn" onclick="filterMemories('Babi', this)">👶 Babi</button>
            <button class="filter-btn" onclick="filterMemories('mot', this)">🗣️ Mots Rigolos</button>
            <button class="filter-btn" onclick="filterMemories('capsule', this)">⏳ Capsule 18 ans</button>
        </div>

        <!-- LISTE DES SOUVENIRS -->
        <section id="memoriesList">
            <!-- Les souvenirs s'affichent ici -->
        </section>
    </main>

    <script>
        // DATES DE NAISSANCE
        const birthDates = {
            'Mima': new Date(2023, 4, 28),   // 28 Mai 2023 (mois 4 en JS = Mai)
            'Babi': new Date(2025, 9, 22)    // 22 Octobre 2025 (mois 9 en JS = Octobre)
        };

        let selectedChild = 'Mima';
        let currentAudioBase64 = null;
        let currentPhotoBase64 = null;
        let mediaRecorder;
        let audioChunks = [];
        let isRecording = false;
        let timerInterval;
        let secondsElapsed = 0;
        let currentFilter = 'all';

        // Date par défaut aujourd'hui
        document.getElementById('memoryDate').value = new Date().toISOString().split('T')[0];

        // 1. Choix de l'enfant
        function selectChild(child) {
            selectedChild = child;
            const optMima = document.getElementById('optMima');
            const optBabi = document.getElementById('optBabi');

            if (child === 'Mima') {
                optMima.className = 'child-option selected-mima';
                optBabi.className = 'child-option';
            } else {
                optBabi.className = 'child-option selected-babi';
                optMima.className = 'child-option';
            }
        }

        function checkCategory() {
            const cat = document.getElementById('memoryCategory').value;
            document.getElementById('funnyWordBox').style.display = (cat === 'mot') ? 'block' : 'none';
        }

        // 2. Calculateur d'âge exact
        function calculateAge(child, eventDateStr) {
            const bDate = birthDates[child];
            const eDate = new Date(eventDateStr);

            if (eDate < bDate) return "Avant la naissance";

            let years = eDate.getFullYear() - bDate.getFullYear();
            let months = eDate.getMonth() - bDate.getMonth();
            let days = eDate.getDate() - bDate.getDate();

            if (days < 0) {
                months--;
                const prevMonth = new Date(eDate.getFullYear(), eDate.getMonth(), 0);
                days += prevMonth.getDate();
            }
            if (months < 0) {
                years--;
                months += 12;
            }

            if (years === 0 && months === 0) return `${days} jours`;
            if (years === 0) return `${months} mois et ${days} jours`;
            if (months === 0) return `${years} an${years > 1 ? 's' : ''}`;
            return `${years} an${years > 1 ? 's' : ''}, ${months} mois`;
        }

        // 3. Gestion Enregistreur Audio
        const recordBtn = document.getElementById('recordBtn');
        const recordBtnText = document.getElementById('recordBtnText');
        const recordTimer = document.getElementById('recordTimer');
        const audioPreview = document.getElementById('audioPreview');

        recordBtn.addEventListener('click', async () => {
            if (!isRecording) {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    mediaRecorder = new MediaRecorder(stream);
                    audioChunks = [];

                    mediaRecorder.ondataavailable = (e) => audioChunks.push(e.data);
                    mediaRecorder.onstop = () => {
                        const blob = new Blob(audioChunks, { type: 'audio/mp3' });
                        const reader = new FileReader();
                        reader.readAsDataURL(blob);
                        reader.onloadend = () => {
                            currentAudioBase64 = reader.result;
                            audioPreview.src = currentAudioBase64;
                            audioPreview.style.display = 'block';
                        };
                    };

                    mediaRecorder.start();
                    isRecording = true;
                    recordBtn.classList.add('recording');
                    recordBtnText.textContent = "Arrêter l'enregistrement";
                    recordTimer.style.display = 'block';
                    secondsElapsed = 0;
                    timerInterval = setInterval(() => {
                        secondsElapsed++;
                        const m = String(Math.floor(secondsElapsed / 60)).padStart(2, '0');
                        const s = String(secondsElapsed % 60).padStart(2, '0');
                        recordTimer.textContent = `${m}:${s}`;
                    }, 1000);
                } catch (err) {
                    alert("Activez l'accès au micro dans votre navigateur pour enregistrer !");
                }
            } else {
                mediaRecorder.stop();
                isRecording = false;
                recordBtn.classList.remove('recording');
                recordBtnText.textContent = "Recommencer l'enregistrement";
                clearInterval(timerInterval);
            }
        });

        // 4. Gestion Photo
        const photoInput = document.getElementById('photoInput');
        const photoPreview = document.getElementById('photoPreview');
        const photoPreviewContainer = document.getElementById('photoPreviewContainer');

        photoInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = (event) => {
                    currentPhotoBase64 = event.target.result;
                    photoPreview.src = currentPhotoBase64;
                    photoPreviewContainer.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });

        // 5. Sauvegarde & Affichage
        const form = document.getElementById('memoryForm');
        form.addEventListener('submit', (e) => {
            e.preventDefault();

            const title = document.getElementById('memoryTitle').value.trim();
            const category = document.getElementById('memoryCategory').value;
            const date = document.getElementById('memoryDate').value;
            const notes = document.getElementById('memoryNotes').value.trim();
            const kidWord = document.getElementById('kidWord').value.trim();
            const realMeaning = document.getElementById('realMeaning').value.trim();

            const ageString = calculateAge(selectedChild, date);

            const newMemory = {
                id: Date.now(),
                child: selectedChild,
                title: title,
                category: category,
                date: date,
                age: ageString,
                notes: notes,
                kidWord: kidWord,
                realMeaning: realMeaning,
                audio: currentAudioBase64,
                photo: currentPhotoBase64
            };

            let memories = JSON.parse(localStorage.getItem('khadija_memories')) || [];
            memories.unshift(newMemory);
            localStorage.setItem('khadija_memories', JSON.stringify(memories));

            form.reset();
            currentAudioBase64 = null;
            currentPhotoBase64 = null;
            audioPreview.style.display = 'none';
            photoPreviewContainer.style.display = 'none';
            recordBtnText.textContent = "Enregistrer la voix";
            recordTimer.style.display = 'none';
            document.getElementById('funnyWordBox').style.display = 'none';
            document.getElementById('memoryDate').value = new Date().toISOString().split('T')[0];

            renderMemories();
            alert("Le souvenir de " + selectedChild + " est précieusement gardé ! ❤️");
        });

        function deleteMemory(id) {
            if (confirm("Voulez-vous vraiment supprimer ce souvenir ?")) {
                let memories = JSON.parse(localStorage.getItem('khadija_memories')) || [];
                memories = memories.filter(m => m.id !== id);
                localStorage.setItem('khadija_memories', JSON.stringify(memories));
                renderMemories();
            }
        }

        function filterMemories(type, btn) {
            currentFilter = type;
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            renderMemories();
        }

        function renderMemories() {
            const list = document.getElementById('memoriesList');
            let memories = JSON.parse(localStorage.getItem('khadija_memories')) || [];

            // Exemples initiaux si la liste est vide
            if (memories.length === 0) {
                memories = [
                    {
                        id: 1,
                        child: 'Mima',
                        title: 'Mima chante sa première comptine',
                        category: 'chanson',
                        date: '2024-11-15',
                        age: calculateAge('Mima', '2024-11-15'),
                        notes: 'Elle adorait chanter ça avant d\'aller dormir !',
                        kidWord: '',
                        realMeaning: '',
                        audio: null,
                        photo: null
                    },
                    {
                        id: 2,
                        child: 'Babi',
                        title: 'Le premier gazouillis de Babi',
                        category: 'rire',
                        date: '2026-01-10',
                        age: calculateAge('Babi', '2026-01-10'),
                        notes: 'Un sourire et un rire dès le matin.',
                        kidWord: '',
                        realMeaning: '',
                        audio: null,
                        photo: null
                    }
                ];
            }

            list.innerHTML = '';

            const filtered = memories.filter(m => {
                if (currentFilter === 'all') return true;
                if (currentFilter === 'Mima') return m.child === 'Mima';
                if (currentFilter === 'Babi') return m.child === 'Babi';
                if (currentFilter === 'mot') return m.category === 'mot';
                if (currentFilter === 'capsule') return m.category === 'capsule';
                return true;
            });

            filtered.forEach(m => {
                const card = document.createElement('div');
                let cardClass = m.child === 'Mima' ? 'memory-card mima-card' : 'memory-card babi-card';
                let tagClass = m.child === 'Mima' ? 'child-tag tag-mima' : 'child-tag tag-babi';
                
                if (m.category === 'capsule') {
                    cardClass = 'memory-card capsule-card';
                    tagClass = 'child-tag tag-capsule';
                }

                let quoteHTML = (m.kidWord && m.realMeaning) 
                    ? `<div class="funny-quote">🗣️ <strong>« ${m.kidWord} »</strong> signifie <strong>« ${m.realMeaning} »</strong></div>` 
                    : '';
                let photoHTML = m.photo ? `<img src="${m.photo}" class="memory-photo" alt="Photo">` : '';
                let audioHTML = m.audio ? `<audio controls src="${m.audio}" class="memory-audio"></audio>` : '';

                card.className = cardClass;
                card.innerHTML = `
                    <button class="btn-delete" onclick="deleteMemory(${m.id})" title="Supprimer">✕</button>
                    <div class="memory-top">
                        <span class="${tagClass}">${m.child === 'Mima' ? '👧 Mima' : '👶 Babi'}</span>
                        <span class="calculated-age">Âge : <strong>${m.age}</strong></span>
                    </div>
                    <h3 class="memory-title font-title">${escapeHTML(m.title)}</h3>
                    ${quoteHTML}
                    ${m.notes ? `<p class="memory-desc">${escapeHTML(m.notes)}</p>` : ''}
                    ${photoHTML}
                    ${audioHTML}
                    <div style="font-size: 0.78rem; color: #A0939B; margin-top: 10px;">📅 Date : ${m.date}</div>
                `;
                list.appendChild(card);
            });
        }

        function escapeHTML(str) {
            return str.replace(/[&<>'"]/g, tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag));
        }

        // Démarrage initial
        renderMemories();
    </script>
</body>
</html>
